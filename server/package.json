{
  "name": "server",
  "license": "MIT",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "db:generate": "bun --env-file=../.env drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "bun --env-file=../.env drizzle-kit migrate --config=drizzle.config.ts",
    "dev": "bun --env-file=../.env --watch --preload src/compat/eventsource.ts src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.57",
    "@ai-sdk/openai": "^3.0.36",
    "@better-auth/drizzle-adapter": "^1.7.1",
    "@better-auth/sso": "^1.7.1",
    "@copilotkit/runtime": "1.68.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "better-auth": "^1.7.1",
    "cel-js": "^0.8.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "e2b": "^2.46.0",
    "eventsource": "3.0.7",
    "hono": "^4.10.0",
    "nodemailer": "^9.0.5",
    "postgres": "^3.4.9",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@copilotkit/aimock": "1.39.0"
  }
}
